---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ModeCard from '../components/ModeCard.astro';
---

<BaseLayout title="R6SDLE | Menú principal">
  <main class="principal">
    <Hero />

    <section class="principal__tarjetas">
      <div class="principal__cuadricula">
        <div class="principal__operador"></div>
        <div class="principal__modo">
          <ModeCard href="/clasico" />
        </div>
        <div class="principal__operador"></div>
      </div>

      <div class="principal__botones"></div>
    </section>
  </main>
</BaseLayout>

<style>
  .principal {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--espacio-6);
    min-height: calc(100vh - 64px);
    width: 100%;
    max-width: var(--ancho-maximo);
    margin-inline: auto;
    padding-block: var(--espacio-8);
    padding-inline: var(--espacio-6);
  }

  .principal__tarjetas {
    width: 100%;
  }

  .principal__cuadricula {
    display: grid;
    grid-template-columns: 1fr 1.9fr 1fr;
    align-items: center;
    gap: var(--espacio-6);
    width: 100%;
  }

  .principal__operador {
    min-height: 320px;
  }

  .principal__modo {
    min-height: 170px;
  }

  .principal__botones {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--espacio-4);
    min-height: 48px;
    margin-top: var(--espacio-6);
  }
</style>
