---
import Nav from './Nav.astro';
---

<header class="header">
  <div class="header__contenido">
    <div class="header__marca"></div>
    <div class="header__navegacion">
      <Nav />
    </div>
  </div>
</header>

<style>
  .header {
    width: 100%;
    height: 64px;
    background-color: var(--color-fondo-alt);
    border-bottom: var(--borde-fino);
  }

  .header__contenido {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espacio-6);
    width: 100%;
    max-width: var(--ancho-maximo);
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--espacio-6);
  }

  .header__marca {
    display: flex;
    align-items: center;
    gap: var(--espacio-3);
  }

  .header__navegacion {
    display: flex;
    align-items: center;
    gap: var(--espacio-6);
  }
</style>