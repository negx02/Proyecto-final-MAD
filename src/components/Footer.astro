---
const anio = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__contenido">
    <div class="footer__estado">
      <span class="footer__punto" aria-hidden="true"></span>
      <span>Sistema en línea</span>
    </div>

    <nav class="footer__enlaces" aria-label="Enlaces del pie de página">
      <a href="/">Inicio</a>
      <a href="/clasico">Modo clásico</a>
    </nav>

    <div class="footer__legal">
      <span>© {anio} R6SDLE · Proyecto escolar sin fines de lucro, no afiliado a Ubisoft.</span>
      <span>Rainbow Six Siege es marca de Ubisoft Entertainment.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    width: 100%;
    background-color: var(--color-fondo-alt);
    border-top: var(--borde-fino);
  }

  .footer__contenido {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espacio-6);
    width: 100%;
    max-width: var(--ancho-maximo);
    min-height: 44px;
    margin-inline: auto;
    padding-inline: var(--espacio-6);
    padding-block: var(--espacio-3);
  }

  .footer__estado,
  .footer__enlaces,
  .footer__legal {
    display: flex;
    align-items: center;
    flex: 1;
    gap: var(--espacio-3);
    min-height: 20px;
    font-family: var(--fuente-mono);
    font-size: var(--texto-xs);
    letter-spacing: 0.08em;
    color: var(--color-texto-tenue);
  }

  .footer__estado {
    gap: var(--espacio-2);
  }

  .footer__punto {
    width: 8px;
    height: 8px;
    background-color: var(--color-correcto);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--color-correcto);
  }

  .footer__enlaces {
    justify-content: center;
    gap: var(--espacio-6);
  }

  .footer__enlaces a {
    color: var(--color-texto-suave);
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .footer__enlaces a:hover,
  .footer__enlaces a:focus-visible {
    color: var(--color-naranja);
  }

  .footer__legal {
    flex-direction: column;
    align-items: flex-end;
    gap: var(--espacio-1);
    text-align: right;
  }

  @media (max-width: 720px) {
    .footer__contenido {
      flex-direction: column;
      gap: var(--espacio-3);
      text-align: center;
    }

    .footer__estado,
    .footer__enlaces {
      justify-content: center;
    }

    .footer__legal {
      align-items: center;
      text-align: center;
    }
  }
</style>