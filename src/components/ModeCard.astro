---
const { href = '/clasico' } = Astro.props;
---

<article class="modo-tarjeta">
  <div class="modo-tarjeta__icono" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="12" cy="12" r="8" />
      <circle cx="12" cy="12" r="3" />
      <path d="M12 2v3M12 19v3M2 12h3M19 12h3" />
    </svg>
  </div>

  <div class="modo-tarjeta__contenido">
    <div class="modo-tarjeta__encabezado">
      <h2 class="modo-tarjeta__titulo">Clásico</h2>
      <span class="modo-tarjeta__etiqueta modo-tarjeta__etiqueta--disponible">Disponible</span>
      <span class="modo-tarjeta__etiqueta">Estándar</span>
    </div>

    <p class="modo-tarjeta__descripcion">
      Consigue pistas con cada intento (Unidad, Rol, Velocidad, Blindaje).
    </p>

    <p class="modo-tarjeta__estado etiqueta-mono">
      <span class="modo-tarjeta__punto" aria-hidden="true"></span>
      Modo activo de hoy
    </p>
  </div>

  <a class="modo-tarjeta__jugar" href={href}>
    Jugar
    <span aria-hidden="true">›</span>
  </a>
</article>

<style>
  .modo-tarjeta {
    display: flex;
    align-items: center;
    gap: var(--espacio-4);
    padding: var(--espacio-6);
    background-color: var(--color-superficie);
    border: var(--borde-fino);
    border-left: 4px solid var(--color-cian);
    border-radius: var(--radio);
  }

  .modo-tarjeta__icono {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    color: var(--color-cian);
    background-color: var(--color-cian-tenue);
    border: 1px solid var(--color-cian);
    border-radius: var(--radio);
  }

  .modo-tarjeta__contenido {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-2);
    flex: 1;
    min-width: 0;
  }

  .modo-tarjeta__encabezado {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--espacio-2);
  }

  .modo-tarjeta__titulo {
    font-size: var(--texto-xl);
    color: var(--color-texto);
  }

  .modo-tarjeta__etiqueta {
    padding: 0.1rem 0.5rem;
    font-family: var(--fuente-mono);
    font-size: var(--texto-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-texto-suave);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
  }

  .modo-tarjeta__etiqueta--disponible {
    color: var(--color-cian);
    background-color: var(--color-cian-tenue);
    border-color: var(--color-cian);
  }

  .modo-tarjeta__descripcion {
    font-size: var(--texto-base);
    color: var(--color-texto-suave);
  }

  .modo-tarjeta__estado {
    display: flex;
    align-items: center;
    gap: var(--espacio-2);
  }

  .modo-tarjeta__punto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-cian);
  }

  .modo-tarjeta__jugar {
    display: inline-flex;
    align-items: center;
    gap: var(--espacio-2);
    flex-shrink: 0;
    padding: var(--espacio-3) var(--espacio-6);
    font-family: var(--fuente-mono);
    font-size: var(--texto-sm);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-cian);
    background-color: var(--color-cian-tenue);
    border: 1px solid var(--color-cian);
    border-radius: var(--radio);
    transition: background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  }

  .modo-tarjeta__jugar:hover,
  .modo-tarjeta__jugar:focus-visible {
    color: var(--color-fondo);
    background-color: var(--color-cian);
    box-shadow: 0 0 18px rgba(34, 211, 238, 0.45);
  }

  .modo-tarjeta__jugar:focus-visible {
    outline: 2px solid var(--color-naranja);
    outline-offset: 3px;
  }
</style>